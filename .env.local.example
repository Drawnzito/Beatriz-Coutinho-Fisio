# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)
# Use a chave "anon public" / "publishable" — NUNCA a chave secreta/service role.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service role) — só usada no servidor, nunca no navegador
SUPABASE_SERVICE_ROLE_KEY=

# Notificações push — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Qualquer string aleatória — protege a rota de cron
CRON_SECRET=
